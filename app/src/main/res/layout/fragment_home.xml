<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.fragments.HomeFragment"
    android:layoutDirection="rtl"
    android:background="@drawable/gradient_background">

    <RelativeLayout
        android:id="@+id/main_top_menu_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="27dp"
        android:layout_marginHorizontal="21dp"
        >

        <LinearLayout
            android:id="@+id/main_user_select_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="horizontal"
            android:background="@drawable/main_layout_background">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_user_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/small_user_icon"
                android:layout_gravity="center"
                />
            <TextView
                android:id="@+id/main_user_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/first_user"
                android:textSize="19sp"
                android:layout_gravity="center"
                android:layout_marginStart="12dp"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_arrow_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_keyboard_arrow_down_24"
                android:layout_gravity="center"
                android:layout_marginStart="12dp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/home_liked_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/main_layout_background"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/main_liked_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/liked"
                android:textSize="19sp"
                android:layout_gravity="center"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_liked_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/small_filled_like"
                android:layout_gravity="center"
                android:layout_marginStart="13dp"
                />
        </LinearLayout>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_video_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_top_menu_layout"
        android:layout_marginHorizontal="21dp"/>


    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@id/home_video_recycler"
        />


</androidx.constraintlayout.widget.ConstraintLayout>